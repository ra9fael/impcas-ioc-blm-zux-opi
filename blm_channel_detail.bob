<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>BLM Channel $(CH)</name>
  <width>1180</width>
  <height>530</height>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <text>Beam Loss Monitor | Channel $(CH)</text>
    <x>18</x>
    <y>12</y>
    <width>500</width>
    <height>34</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>CH0</name>
    <actions>
      <action type="open_display">
        <description>Open Display</description>
        <file>blm_channel_detail.bob</file>
        <macros>
          <P>$(P)</P>
          <CH>0</CH>
        </macros>
        <target>replace</target>
      </action>
    </actions>
    <text>CH0</text>
    <x>620</x>
    <y>14</y>
    <width>64</width>
    <height>32</height>
    <tooltip>$(actions)</tooltip>
  </widget>
