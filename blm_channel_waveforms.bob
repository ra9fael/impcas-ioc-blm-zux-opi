<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>BLM Waveforms CH$(CH)</name>
  <width>1200</width>
  <height>920</height>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <text>Waveforms - CH$(CH)</text>
    <x>15</x>
    <y>8</y>
    <width>500</width>
    <height>30</height>
    <font>
      <font name="Header 2" family="Liberation Sans" style="BOLD" size="18.0">
      </font>
    </font>
  </widget>
  <widget type="group" version="3.0.0">
    <name>RealtimeScales</name>
    <x>12</x>
    <y>42</y>
    <width>506</width>
    <height>81</height>
    <font>
      <font name="Header 3" family="Liberation Sans" style="BOLD" size="16.0">
      </font>
    </font>
    <widget type="label" version="2.0.0">
      <name>Label</name>
      <text>Realtime</text>
      <width>80</width>
      <height>32</height>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>A</name>
      <actions>
        <action type="open_display">
          <description>Open Display</description>
          <file>blm_channel_waveforms.bob</file>
          <macros>
            <P>$(P)</P>
            <CH>$(CH)</CH>
            <RTSCALE>10US</RTSCALE>
            <RTDP></RTDP>
            <HISTSCALE>$(HISTSCALE)</HISTSCALE>
          </macros>
          <target>replace</target>
        </action>
      </actions>
      <text>10 us</text>
      <x>85</x>
      <width>90</width>
      <height>32</height>
      <tooltip>$(actions)</tooltip>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>B</name>
      <actions>
        <action type="open_display">
          <description>Open Display</description>
          <file>blm_channel_waveforms.bob</file>
          <macros>
            <P>$(P)</P>
            <CH>$(CH)</CH>
            <RTSCALE>1MS</RTSCALE>
            <RTDP>_3000DP</RTDP>
            <HISTSCALE>$(HISTSCALE)</HISTSCALE>
          </macros>
          <target>replace</target>
        </action>
      </actions>
      <text>1 ms</text>
      <x>180</x>
      <width>90</width>
      <height>32</height>
      <tooltip>$(actions)</tooltip>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
