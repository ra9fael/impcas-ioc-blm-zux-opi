  <widget type="group" version="3.0.0">
    <name>Plot channel</name>
    <x>680</x>
    <y>52</y>
    <width>520</width>
    <height>78</height>
    <font>
      <font name="Header 3" family="Liberation Sans" style="BOLD" size="16.0">
      </font>
    </font>
    <widget type="action_button" version="3.0.0">
      <name>PCh0</name>
      <actions>
        <action type="open_display">
          <description>Open Display</description>
          <file>blm_fbr_mean.bob</file>
          <macros>
            <P>$(P)</P>
            <CH>0</CH>
            <SCALE>$(SCALE)</SCALE>
          </macros>
          <target>replace</target>
        </action>
      </actions>
      <text>CH0</text>
      <width>78</width>
      <height>32</height>
      <tooltip>$(actions)

Reopens this page for the selected channel. Only the plot and the two
readouts below it follow the channel; the three groups on the left show
every channel's mean and its own window length.</tooltip>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>PCh1</name>
      <actions>
        <action type="open_display">
          <description>Open Display</description>
          <file>blm_fbr_mean.bob</file>
          <macros>
            <P>$(P)</P>
            <CH>1</CH>
            <SCALE>$(SCALE)</SCALE>
          </macros>
          <target>replace</target>
        </action>
      </actions>
