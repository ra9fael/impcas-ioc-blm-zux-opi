<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>BLM FBR Means</name>
  <macros>
    <CH>$(CH)</CH>
    <P>$(P)</P>
    <SCALE>$(SCALE)</SCALE>
  </macros>
  <width>1200</width>
  <height>880</height>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <text>FBR realtime window means</text>
    <x>15</x>
    <y>10</y>
    <width>600</width>
    <height>30</height>
    <font>
      <font name="Header 2" family="Liberation Sans" style="BOLD" size="18.0">
      </font>
    </font>
    <horizontal_alignment>1</horizontal_alignment>
  </widget>
  <widget type="group" version="3.0.0">
    <name>FBR mean 1 ms (cnt/1ms)</name>
    <x>15</x>
    <y>52</y>
    <width>645</width>
    <height>141</height>
    <font>
      <font name="Header 3" family="Liberation Sans" style="BOLD" size="16.0">
      </font>
    </font>
    <widget type="textupdate" version="2.0.0">
      <name>M1Ch0</name>
      <pv_name>$(P):CH0:FBR_MEAN_1MS</pv_name>
      <width>85</width>
      <height>32</height>
      <format>3</format>
      <precision>2</precision>
      <show_units>false</show_units>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
      <tooltip>$(P):CH0:FBR_MEAN_1MS (CH0_FBR_MEAN_1MS)

Mean of the newest $(P):CH0:MEAN_WIN_1MS points of
$(P):CH0:FBR_RT_1MS_3000DP.

Unit cnt/1ms: the averaged points are bucket sums, so the result is
counts per bucket and is directly comparable with that waveform and
with $(P):CH0:FBR_ILK_TH_1MS. While the ring holds fewer points
than the window, this is the mean of all points available.
Updated at about 10 Hz.</tooltip>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
    <widget type="label" version="2.0.0">
      <name>M1Ch0Label</name>
      <text>CH0</text>
