    <widget type="action_button" version="3.0.0">
      <name>BLM00</name>
      <actions>
        <action type="open_display">
          <description>Open Display</description>
          <file>blm.bob</file>
          <macros>
            <P>XRAY:BLM00</P>
          </macros>
          <target>window</target>
        </action>
      </actions>
      <text>BLM00</text>
      <width>195</width>
      <height>48</height>
      <tooltip>Open blm.bob with P=XRAY:BLM00 - all controls and readbacks address that unit only (XRAY:BLM00:*)</tooltip>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
