  <widget type="xyplot" version="3.0.0">
    <name>RawdataPlot</name>
    <x>12</x>
    <y>320</y>
    <width>1216</width>
    <height>465</height>
    <title>Rawdata - CH$(CH)</title>
    <show_toolbar>true</show_toolbar>
    <tooltip>$(P):CH$(CH):RAWDATA

Most recent rawdata acquisition of channel $(CH), 2000 calibrated samples
published by the rawdata thread. Use the channel buttons above to switch the
displayed channel; the trigger configuration controls when a new acquisition
is taken.</tooltip>
    <x_axis>
      <title>Sample</title>
      <autoscale>true</autoscale>
      <log_scale>false</log_scale>
      <minimum>0.0</minimum>
      <maximum>100.0</maximum>
      <show_grid>true</show_grid>
      <title_font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </title_font>
      <scale_font>
        <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
        </font>
      </scale_font>
      <visible>true</visible>
    </x_axis>
    <y_axes>
      <y_axis>
        <title>Calibrated value</title>
        <autoscale>true</autoscale>
        <log_scale>false</log_scale>
        <minimum>0.0</minimum>
        <maximum>100.0</maximum>
        <show_grid>true</show_grid>
        <title_font>
          <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
          </font>
        </title_font>
        <scale_font>
          <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
          </font>
        </scale_font>
        <on_right>false</on_right>
        <visible>true</visible>
        <color>
          <color name="Text" red="0" green="0" blue="0">
          </color>
        </color>
      </y_axis>
    </y_axes>
    <traces>
      <trace>
        <name>CH$(CH)</name>
        <x_pv></x_pv>
        <y_pv>$(P):CH$(CH):RAWDATA</y_pv>
        <err_pv></err_pv>
        <axis>0</axis>
        <trace_type>1</trace_type>
        <color>
          <color red="0" green="0" blue="255">
          </color>
        </color>
        <line_width>1</line_width>
        <line_style>0</line_style>
        <point_type>0</point_type>
        <point_size>10</point_size>
        <visible>true</visible>
      </trace>
    </traces>
  </widget>
