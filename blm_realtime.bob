<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>BLM Realtime</name>
  <width>1200</width>
  <height>780</height>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <text>Realtime data - CH$(CH) - $(SCALE)</text>
    <x>15</x>
    <y>10</y>
    <width>550</width>
    <height>30</height>
    <font>
      <font name="Header 2" family="Liberation Sans" style="BOLD" size="18.0">
      </font>
    </font>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Channels</name>
    <x>597</x>
    <y>37</y>
    <width>576</width>
    <height>78</height>
    <font>
      <font name="Header 3" family="Liberation Sans" style="BOLD" size="16.0">
      </font>
    </font>
    <widget type="action_button" version="3.0.0">
      <name>C0</name>
      <actions>
        <action type="open_display">
          <description>Open Display</description>
          <file>blm_realtime.bob</file>
          <macros>
            <P>$(P)</P>
            <CH>0</CH>
            <SCALE>$(SCALE)</SCALE>
            <DP>$(DP)</DP>
          </macros>
          <target>replace</target>
        </action>
      </actions>
      <text>CH0</text>
      <width>85</width>
      <height>32</height>
      <tooltip>$(actions)</tooltip>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>C1</name>
      <actions>
        <action type="open_display">
          <description>Open Display</description>
          <file>blm_realtime.bob</file>
          <macros>
            <P>$(P)</P>
            <CH>1</CH>
            <SCALE>$(SCALE)</SCALE>
            <DP>$(DP)</DP>
          </macros>
          <target>replace</target>
        </action>
      </actions>
      <text>CH1</text>
      <x>90</x>
      <width>85</width>
      <height>32</height>
      <tooltip>$(actions)</tooltip>
    </widget>
