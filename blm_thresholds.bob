      <width>125</width>
      <height>30</height>
      <format>3</format>
      <precision>6</precision>
      <tooltip>$(P):CH$(CH):FBR_ILK_TH_1MS (FBR_ILK_TH_CH$(CH)_1MS)
Fiber-count interlock threshold, counts. Enter a non-negative integer; scientific notation such as 1e9 is accepted. Written to the FPGA 1ms window threshold.</tooltip>
      <horizontal_alignment>1</horizontal_alignment>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
    <widget type="textentry" version="3.0.0">
