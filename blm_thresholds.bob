      <x>255</x>
      <y>125</y>
      <width>125</width>
      <height>30</height>
      <format>3</format>
      <precision>6</precision>
      <tooltip>$(P):CH$(CH):FBR_ILK_TH_100US (FBR_ILK_TH_CH$(CH)_100US)
Fiber-count interlock threshold, counts. Enter a non-negative integer; scientific notation such as 1e9 is accepted. Written to the FPGA 100us window threshold.</tooltip>
      <horizontal_alignment>1</horizontal_alignment>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>F3</name>
