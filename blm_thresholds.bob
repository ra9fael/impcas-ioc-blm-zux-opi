    </widget>
    <widget type="textentry" version="3.0.0">
      <name>F1</name>
      <pv_name>$(P):CH$(CH):FBR_ILK_TH_10US</pv_name>
      <x>125</x>
      <y>125</y>
      <width>125</width>
      <height>30</height>
      <format>3</format>
      <precision>6</precision>
      <tooltip>$(P):CH$(CH):FBR_ILK_TH_10US (FBR_ILK_TH_CH$(CH)_10US)
Fiber-count interlock threshold, counts. Enter a non-negative integer; scientific notation such as 1e9 is accepted. Written to the FPGA 10us window threshold.</tooltip>
      <horizontal_alignment>1</horizontal_alignment>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>F2</name>
